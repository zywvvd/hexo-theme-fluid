<%
page.layout = "earth_sta"
page.title = theme.links.title || __('earthsta.title')
page.subtitle = theme.links.subtitle || __('earthsta.subtitle')
page.banner_img = theme.links.banner_img
page.banner_img_height = theme.links.banner_img_height
page.banner_mask_alpha = theme.links.banner_mask_alpha
page.comment = 'waline'
%>

<style type="text/css">
.banner {
  height: 0px;
  position: relative;
  overflow: hidden;
  cursor: default;
}

.header-inner{
  height: 60vh;
}

.earth_title{
  height: 10vh;
  color: #fff;
  text-align: center;
}

.earth_word{
  font-size: 2.15rem;
  text-align: center;
  vertical-align: center;
  margin: 10px;
}

.footer-inner {
    padding: 0rem 0 1rem 0;
    text-align: center;
}

/* 访客足迹面板(地球 2.0) */
#vvd-planet-stats{
  position: fixed; right: 2vw; top: 14vh; width: 240px;
  padding: 14px 16px; border-radius: 12px;
  background: rgba(8, 20, 38, 0.55);
  border: 1px solid rgba(80,160,255,0.25);
  box-shadow: 0 8px 32px rgba(0,0,0,0.35);
  color: #dcecff; font-size: 13px; z-index: 10;
  backdrop-filter: blur(6px);
}
#vvd-planet-stats .vps-title{ font-size: 15px; font-weight: 600; letter-spacing: 1px; margin-bottom: 10px; color: #9fd8ff; }
#vvd-planet-stats .vps-nums{ display: flex; justify-content: space-between; margin-bottom: 12px; }
#vvd-planet-stats .vps-nums b{ display: block; font-size: 20px; color: #fff; }
#vvd-planet-stats .vps-nums span{ color: #7fa8c9; font-size: 12px; }
#vvd-planet-stats .vps-sub{ margin: 10px 0 6px; color: #9fd8ff; font-size: 12px; letter-spacing: 1px; }
#vvd-planet-stats .vps-row{ margin: 5px 0; }
#vvd-planet-stats .vps-row .vps-bar{ height: 6px; border-radius: 3px; background: linear-gradient(90deg,#2b7bff,#39d0ff); width: 0; transition: width 0.8s ease; }
#vvd-planet-stats .vps-row .vps-line{ display: flex; justify-content: space-between; font-size: 12px; color: #bcd8ee; }
@media (max-width: 1200px){ #vvd-planet-stats{ display: none; } }
#vvd-starfield{ position: fixed; inset: 0; z-index: -770; pointer-events: none; }

/* 全屏模式(地球 2.0): 挣脱主题框架 */
body.earth-fs .navbar { display: none !important; }
body.earth-fs .banner { display: none !important; }
body.earth-fs .footer-inner { display: none !important; }
body.earth-fs #fatherobj3 { position: fixed; inset: 0; z-index: 1; }
body.earth-fs .earth_title { position: fixed; top: 2vh; left: 0; right: 0; z-index: 20; height: auto; pointer-events: none; }
body.earth-fs .vvd-fs-spacer { height: 100vh; }
.vvd-fs-comments { position: relative; z-index: 30; background: rgba(4,12,24,0.78); padding: 20px 0 40px; margin-top: 16px; }
.vvd-fs-comments-inner { max-width: 720px; margin: 0 auto; padding: 0 16px; color: #dcecff; }
#vvd-planet-stats .vps-me { margin: -6px 0 10px; color: #ff6b60; font-size: 12px; }
body.earth-fs #vvd-fs-video { position: fixed; inset: 0; z-index: -776; pointer-events: none; }
body.earth-fs #vvd-fs-video video { width: 100%; height: 100%; object-fit: cover; }
body.earth-fs #vvd-fs-jump { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); z-index: 20; }
body.earth-fs #vvd-fs-jump a { color: #9fd8ff; border: 1px solid rgba(80,160,255,0.35); background: rgba(8,20,38,0.55); padding: 6px 14px; border-radius: 16px; text-decoration: none; font-size: 13px; }
</style>



<div class="earth_title">
	<div class="earth_word">
		30天内的来访者
	</div>
	〇&nbsp 越早来访越暗 &nbsp→&nbsp <span style="color:#fff">〇</span>&nbsp 越新越亮 &nbsp·&nbsp 拖动旋转 · 滚轮缩放
</div>

<div id='fatherobj3'>
    <canvas id='quakeCanvas3'></canvas>
</div>

<div id='vvd-planet-stats'>
  <div class="vps-title">近 30 天访客足迹</div>
  <div id="vps-me" class="vps-me">当前位置(你): 定位中…</div>
  <div class="vps-nums">
    <div><b id="vps-visits">—</b><span>访问</span></div>
    <div><b id="vps-ips">—</b><span>访客</span></div>
    <div><b id="vps-countries">—</b><span>国家</span></div>
  </div>
  <div class="vps-sub">国家 TOP 10</div>
  <div id="vps-countries-list"></div>
  <div class="vps-sub">城市 TOP 5</div>
  <div id="vps-cities-list"></div>
</div>
<canvas id="vvd-starfield"></canvas>

<div id="vvd-fs-video"></div>
<div id="vvd-fs-jump"><a href="#vvd-fs-comments">⬇ 评论区</a></div>

<div class="vvd-fs-spacer"></div>
<div class="vvd-fs-comments">
  <div class="vvd-fs-comments-inner">
<%- partial('_partials/comments/waline') %>
  </div>
</div>

<script defer type='text/javascript' src='https://img.zywvvd.com:61213/HexoFiles/js/planetaryjs/d3.v3.min.js'></script>
<script defer type='text/javascript' src='https://img.zywvvd.com:61213/HexoFiles/js/planetaryjs/topojson.v1.min.js'></script>
<script defer type='text/javascript' src='https://img.zywvvd.com:61213/HexoFiles/js/planetaryjs/planetaryjs.min.js'></script>
<script defer type='text/javascript' src='https://img.zywvvd.com:61213/HexoFiles/js/planetaryjs/moment.min.js'></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
(function() {
  var canvas = document.getElementById('quakeCanvas3');
  var board_obj = document.getElementById('fatherobj3');
  
  // —— 全屏模式(地球 2.0): 挣脱主题框架 ——
  document.body.classList.add('earth-fs');
  var header_obj = document.getElementsByClassName('header-inner')[0];
  if (header_obj) header_obj.style.display = 'none';
  var nav_obj = document.querySelector('.navbar');
  if (nav_obj) nav_obj.style.display = 'none';
  var footer_obj = document.querySelector('.footer-inner');
  if (footer_obj) footer_obj.style.display = 'none';
  var temp_board_obj = document.getElementById('board');
  if (temp_board_obj) temp_board_obj.style.cssText = 'background-color: transparent; box-shadow: none; width: 100%; padding: 0;';
  var real_mask_obj = document.getElementsByClassName('real_mask')[0];
  if (real_mask_obj) real_mask_obj.style.cssText = 'background-color: rgba(0,0,0,0.45); z-index: -779; height: 100%; position: fixed; width: 100%;';

  var body_height = window.innerHeight;
  var body_width = window.innerWidth;
  var real_container_obj = document.getElementsByClassName('container');
  for (var i = 0; i < real_container_obj.length; i++) {
    real_container_obj[i].style.maxWidth = '100%';
  }
  var real_col_obj = document.getElementsByClassName('col-md-10');
  for (var i = 0; i < real_col_obj.length; i++) {
    real_col_obj[i].style.maxWidth = '100%';
  }
  window.addEventListener('resize', function () {
    body_height = window.innerHeight;
    body_width = window.innerWidth;
  });
  
  // Create our Planetary.js planet and set some initial values;
  // we use several custom plugins, defined at the bottom of the file
  var planet = planetaryjs.planet();
  planet.loadPlugin(autocenter({extraHeight: -120}));
  planet.loadPlugin(autoscale({extraHeight: -120}));
  planet.loadPlugin(planetaryjs.plugins.earth({
    topojson: { file:   'https://img.zywvvd.com:61213/HexoFiles/js/planetaryjs/world-110m.json' },
    oceans:   { fill:   '#001320' },
    land:     { fill:   '#06304e' },
    borders:  { stroke: '#001320' }
  }));
  // 大气光晕: 在地球外缘绘制径向渐变, 提升太空感
  planet.loadPlugin(function (globe) {
    globe.onDraw(function () {
      var ctx = globe.context;
      if (!ctx) return;
      var t = globe.projection.translate();
      var r = globe.projection.scale();
      var grad = ctx.createRadialGradient(t[0], t[1], r * 0.98, t[0], t[1], r * 1.28);
      grad.addColorStop(0, 'rgba(70,150,255,0.32)');
      grad.addColorStop(0.45, 'rgba(50,110,255,0.10)');
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.save();
      ctx.beginPath();
      ctx.fillStyle = grad;
      ctx.arc(t[0], t[1], r * 1.28, 0, 2 * Math.PI, false);
      ctx.fill();
      ctx.restore();
    });
  });
  planet.loadPlugin(planetaryjs.plugins.pings());
  planet.loadPlugin(planetaryjs.plugins.zoom({
    scaleExtent: [50, 5000]
  }));
  planet.loadPlugin(planetaryjs.plugins.drag({
    onDragStart: function() {
      this.plugins.autorotate.pause();
    },
    onDragEnd: function() {
      this.plugins.autorotate.resume();
    }
  }));
  planet.loadPlugin(autorotate(5));
  planet.projection.rotate([250, -20, 0]);
  planet.draw(canvas);
  // 星空背景: 固定画布层, 220 颗闪烁星(半帧率省电)
  (function () {
    var sf = document.getElementById('vvd-starfield');
    var sctx = sf.getContext('2d');
    var stars = [];
    function seed() {
      sf.width = window.innerWidth; sf.height = window.innerHeight;
      stars = [];
      for (var i = 0; i < 220; i++) {
        stars.push({
          x: Math.random() * sf.width,
          y: Math.random() * sf.height,
          r: Math.random() * 1.3 + 0.3,
          p: Math.random() * Math.PI * 2,
          s: 0.008 + Math.random() * 0.02
        });
      }
    }
    seed();
    window.addEventListener('resize', seed);
    var frame = 0;
    (function twinkle() {
      frame++;
      if (frame % 2 === 0) {
        sctx.clearRect(0, 0, sf.width, sf.height);
        for (var i = 0; i < stars.length; i++) {
          var st = stars[i];
          st.p += st.s;
          sctx.globalAlpha = 0.25 + 0.6 * (0.5 + 0.5 * Math.sin(st.p));
          sctx.fillStyle = '#cfe6ff';
          sctx.beginPath();
          sctx.arc(st.x, st.y, st.r, 0, 2 * Math.PI);
          sctx.fill();
        }
        sctx.globalAlpha = 1;
      }
      requestAnimationFrame(twinkle);
    })();
  })();
  // 全屏背景视频(桌面且未开启减动效才启用)
  (function () {
    var skip = matchMedia('(prefers-reduced-motion: reduce)').matches || matchMedia('(pointer: coarse)').matches;
    if (skip) return;
    fetch('https://pvuv.zywvvd.com:61213/wallpaper-pair')
      .then(function (r) { return r.ok ? r.json() : Promise.reject(0); })
      .then(function (pairs) {
        var pair = pairs[Math.floor(Math.random() * pairs.length)];
        var v = document.createElement('video');
        v.src = pair[0]; v.poster = pair[1];
        v.muted = true; v.loop = true; v.autoplay = true;
        v.setAttribute('playsinline', '');
        document.getElementById('vvd-fs-video').appendChild(v);
        var pr = v.play(); if (pr && pr.catch) pr.catch(function () {});
      })
      .catch(function () {});
  })();
  var jump = document.querySelector('#vvd-fs-jump a');
  if (jump) jump.addEventListener('click', function (e) {
    e.preventDefault();
    var cm = document.querySelector('.vvd-fs-comments');
    if (cm) cm.scrollIntoView({ behavior: 'smooth' });
  });
  // 访客足迹统计面板(静默失败不影响地球)
  fetch('https://pvuv.zywvvd.com:61213/planet_stats')
    .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
    .then(function (s) {
      if (!s || !s.visits) return;
      var fmt = function (n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ','); };
      document.getElementById('vps-visits').textContent = fmt(s.visits);
      document.getElementById('vps-ips').textContent = fmt(s.distinct);
      document.getElementById('vps-countries').textContent = s.country_total;
      var maxc = s.countries.length ? s.countries[0].count : 1;
      var cl = document.getElementById('vps-countries-list');
      s.countries.forEach(function (c) {
        var row = document.createElement('div');
        row.className = 'vps-row';
        row.innerHTML = '<div class="vps-line"><span>' + c.name + '</span><span>' + c.count + '</span></div><div class="vps-bar"></div>';
        cl.appendChild(row);
        requestAnimationFrame(function () { row.querySelector('.vps-bar').style.width = Math.max(8, c.count / maxc * 100) + '%'; });
      });
      var cl2 = document.getElementById('vps-cities-list');
      s.cities.forEach(function (c) {
        var row = document.createElement('div');
        row.className = 'vps-row';
        row.innerHTML = '<div class="vps-line"><span>' + c.name + '</span><span>' + c.count + '</span></div><div class="vps-bar"></div>';
        cl2.appendChild(row);
        requestAnimationFrame(function () { row.querySelector('.vps-bar').style.width = Math.max(8, c.count / (s.cities[0].count || 1) * 100) + '%'; });
      });
    })
    .catch(function () { /* 面板静默失败 */ });
  fetch("https://pvuv.zywvvd.com:61213/planet_info", { headers: { "Content-Type": "application/json" } })
    .then(function (r) {
      if (!r.ok) throw new Error("planet_info " + r.status);
      return r.json();
    })
    .then(function (data) {
              // 当前访客(你)与历史足迹分离: me=服务端标记的定位点
              var mePoints = [];
              var historyData = [];
              (data || []).forEach(function (d) {
                if (d.me) { mePoints.push(d); } else { historyData.push(d); }
              });
              if (!historyData.length && !mePoints.length) {
                console.warn("planet_info empty: globe without visitor pings");
                return;
              }
              if (!historyData.length) historyData = mePoints.slice(0, 1);
              var data = historyData;
              // 新近度配色: 按数据序号映射, 越新的访客越亮——历史点整体调暗(当前访客单独高亮)
              var recency = d3.scale.linear().domain([0, data.length]).range([0, 1]);
              var colors = d3.scale.linear()
                .domain([0, 0.6, 1])
                .range(['#244f8f', '#2e86c8', '#a8d8ff']);
              var angles = d3.scale.linear().domain([0, 1]).range([1.2, 3.5]);
              var ttls = d3.scale.linear().domain([0, 1]).range([1500, 2200]);
                var start = parseInt(data[0].time, 10);
                var end = parseInt(data[data.length - 1].time, 10);
                var currentTime = start;
                var lastTick = new Date().getTime();
                var updateDate = function() {
                  d3.select('#date').text(moment(currentTime).utc().format("MMM DD YYYY HH:mm UTC"));
                };
                // A scale that maps a percentage of playback to a time
                // from the data; for example, `50` would map to the halfway
                // mark between the first and last items in our data array.
                var percentToDate = d3.scale.linear()
                  .domain([0, 100])
                  .range([start, end]);
                // A scale that maps real time passage to data playback time.
                // 12 minutes of real time maps to the entirety of the
                // timespan covered by the data.
                var realToData = d3.scale.linear()
                  .domain([0, 1000 * 60 * 12])
                  .range([0, end - start]);
                var paused = false;
                // Pause playback and update the time display
                // while scrubbing using the range input.
                d3.select('#slider')
                  .on('change', function(d) {
                    currentTime = percentToDate(d3.event.target.value);
                    updateDate();
                  })
                  .call(d3.behavior.drag()
                    .on('dragstart', function() {
                      paused = true;
                    })
                    .on('dragend', function() {
                      paused = false;
                    })
                  );
                // The main playback loop; for each tick, we'll see how much
                // time passed in our accelerated playback reel and find all
                // the earthquakes that happened in that timespan, adding
                // them to the globe with a color and angle relative to their magnitudes.
                d3.timer(function() {
                  var now = new Date().getTime();
                  if (paused) {
                    lastTick = now;
                    return;
                  }
                  var realDelta = now - lastTick;
                  // Avoid switching back to the window only to see thousands of pings;
                  // if it's been more than 500 milliseconds since we've updated playback,
                  // we'll just set the value to 500 milliseconds.
                  realDelta = 5000;
                  var dataDelta = realToData(realDelta);
                  var toPing = data.filter(function(d) {
                    return d.time >= currentTime && d.time <= currentTime + dataDelta;
                  });
                  for (var i = 0; i < toPing.length; i++) {
                    var ping = toPing[i];
                    var rec = (ping.time - start) / Math.max(1, end - start);
                    planet.plugins.pings.add(ping.lat, ping.lng, {
                      angle: angles(rec),
                      color: colors(rec),
                      ttl:   ttls(rec)
                    });
                  }
                  currentTime += dataDelta;
                  if (currentTime > end) currentTime = start;
                  updateDate();
                  d3.select('#slider').property('value', percentToDate.invert(currentTime));
                  lastTick = now;
                });
              // 当前访客(你): 高亮红点常驻脉冲 + 面板位置信息(mePoints 已由上方分流)
              if (mePoints.length) {
                var me = mePoints[0];
                var addMe = function () {
                  planet.plugins.pings.add(me.lat, me.lng, { angle: 9, color: '#ff3b30', ttl: 5000 });
                };
                addMe();
                setInterval(addMe, 2600);
                var locText = [me.city, me.country].filter(function (x) { return x && x !== '-'; }).join(', ');
                var el = document.getElementById('vps-me');
                if (el) el.textContent = locText ? '当前位置(你): ' + locText : '当前位置(你): 已定位';
              }
    })
    .catch(function (err) {
      console.error("planet_info load failed:", err);
    });
  // Plugin to resize the canvas to fill the window and to
  // automatically center the planet when the window size changes
  function autocenter(options) {
    options = options || {};
    var needsCentering = false;
    var globe = null;
    var resize = function() {
      var width  = board_obj.offsetWidth;
      //var height = board_obj.offsetWidth;
	  //var width  = body_width;
      var height = body_height;
  
      globe.canvas.width = width;
      globe.canvas.height = height;
      globe.projection.translate([width / 2, height / 2]);
    };
    return function(planet) {
      globe = planet;
      planet.onInit(function() {
        needsCentering = true;
        d3.select(window).on('resize', function() {
          needsCentering = true;
        });
      });
      planet.onDraw(function() {
        if (needsCentering) { resize(); needsCentering = false; }
      });
    };
  };
  // Plugin to automatically scale the planet's projection based
  // on the window size when the planet is initialized
  function autoscale(options) {
    options = options || {};
    return function(planet) {
      planet.onInit(function() {
        //var width  = board_obj.offsetWidth;
        //var height = board_obj.offsetWidth;
        var width  = body_width;
        var height = body_height;
        planet.projection.scale(Math.min(width, height) / 2.3);
      });
    };
  };
  // Plugin to automatically rotate the globe around its vertical
  // axis a configured number of degrees every second.
  function autorotate(degPerSec) {
    return function(planet) {
      var lastTick = null;
      var paused = false;
      planet.plugins.autorotate = {
        pause:  function() { paused = true;  },
        resume: function() { paused = false; }
      };
      planet.onDraw(function() {
        if (paused || !lastTick) {
          lastTick = new Date();
        } else {
          var now = new Date();
          var delta = now - lastTick;
          var rotation = planet.projection.rotate();
          rotation[0] += degPerSec * delta / 1000;
          if (rotation[0] >= 180) rotation[0] -= 360;
          planet.projection.rotate(rotation);
          lastTick = now;
        }
      });
    };
  };
})();
});
</script>



